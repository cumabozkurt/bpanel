FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y -q systemd systemd-sysv dbus ca-certificates curl jq sudo iproute2 openssh-server cron python3 && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN systemctl mask systemd-logind.service getty.target console-getty.service systemd-udevd.service systemd-networkd-wait-online.service || true
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
