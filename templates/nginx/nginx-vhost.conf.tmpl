# Managed by BOZKURT PANEL (template v{{.TemplateVersion}}) — changes are overwritten.
# account: {{safe .User}}  domain: {{safe .Domain}}
{{- define "body"}}
    root "{{safe .DocRoot}}";
    # never follow a symlink to a file owned by someone else (shared-hosting symlink attacks)
    disable_symlinks if_not_owner from=$document_root;
    index index.php index.html index.htm;
    access_log "/var/log/bpanel/domlogs/{{safe .Domain}}.access.log" combined;
    error_log  "/var/log/bpanel/domlogs/{{safe .Domain}}.error.log" warn;
    client_max_body_size 256m;
{{- if .WAFInclude}}
    # per-domain WAF (ModSecurity v3); rendered only when the module is installed and WAF mode != off
    include "{{safe .WAFInclude}}";
{{- end}}
{{- if .WebXInclude}}
    # per-domain web extras (directory privacy, hotlink, error pages, MIME types, IP blocker)
    include "{{safe .WebXInclude}}";
{{- end}}
{{- if .AppXInclude}}
    # application proxy locations (Application Manager)
    include "{{safe .AppXInclude}}";
{{- end}}

    location ^~ /.well-known/acme-challenge/ { root /var/lib/bpanel/acme; default_type text/plain; }
    location ~ /\.(ht|git|svn|env) { deny all; }
{{- if .Suspended}}
    location / { root /usr/share/bpanel/suspended; try_files /index.html =503; }
{{- else if .Redirect}}
    location / { return 301 "{{safe .Redirect}}$request_uri"; }
{{- else if .AppXRootPort}}
    # the whole site is an application (Application Manager)
    location / {
        proxy_pass http://127.0.0.1:{{.AppXRootPort}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
    }
{{- else if eq .Mode "nginx"}}
    location / { try_files $uri $uri/ /index.php?$args; }
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass "unix:{{safe .PHPSocket}}";
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS $https if_not_empty;
        fastcgi_read_timeout 300;
    }
    location ~* \.(?:css|js|jpe?g|png|gif|ico|svg|webp|avif|woff2?|ttf|eot|mp4|webm)$ { expires 7d; access_log off; try_files $uri =404; }
{{- else}}
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
    }
    location ~* \.(?:css|js|jpe?g|png|gif|ico|svg|webp|avif|woff2?|ttf|eot|mp4|webm)$ { expires 7d; access_log off; try_files $uri @apache; }
    location @apache {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
{{- end}}
{{- end}}

server {
    listen 80;
    listen [::]:80;
    server_name{{range .Names}} {{safe .}}{{end}};
{{- if .SSL}}
    location ^~ /.well-known/acme-challenge/ { root /var/lib/bpanel/acme; default_type text/plain; }
    location / { return 301 https://$host$request_uri; }
}

server {
{{- if .HTTP2On}}
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
{{- else}}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
{{- end}}
    server_name{{range .Names}} {{safe .}}{{end}};
    ssl_certificate     "{{safe .CertFile}}";
    ssl_certificate_key "{{safe .KeyFile}}";
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:bpanel:10m;
    add_header Strict-Transport-Security "max-age=31536000" always;
{{- end}}
{{- template "body" .}}
}
