; Managed by BOZKURT PANEL (template v{{.TemplateVersion}}) — changes are overwritten.
[bpanel-{{safe .User}}]
user = {{safe .User}}
group = {{safe .User}}
listen = {{safe .Socket}}
listen.owner = {{safe .User}}
listen.group = bpanel-web
listen.mode = 0660
pm = ondemand
pm.max_children = {{safe .MaxChildren}}
pm.process_idle_timeout = 20s
pm.max_requests = 500
chdir = {{safe .Home}}
catch_workers_output = yes
security.limit_extensions = .php
env[TMPDIR] = {{safe .Home}}/tmp
php_admin_value[open_basedir] = {{safe .Home}}:/usr/share/php:/usr/share/pear
php_admin_value[sys_temp_dir] = {{safe .Home}}/tmp
php_admin_value[upload_tmp_dir] = {{safe .Home}}/tmp
php_admin_value[session.save_path] = {{safe .Home}}/tmp
php_admin_value[error_log] = {{safe .Home}}/logs/php-error.log
php_admin_flag[log_errors] = on
php_value[memory_limit] = {{safe .MemoryLimit}}
php_value[upload_max_filesize] = {{safe .UploadMax}}
php_value[post_max_size] = {{safe .UploadMax}}
php_value[max_execution_time] = {{safe .MaxExecution}}
{{- range $k, $v := .INI}}
php_value[{{safe $k}}] = {{$v}}
{{- end}}
